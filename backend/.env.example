# Copy this file to .env (same folder) and adjust as needed.
# .env is ignored by Git. If .env is missing, these same defaults are used.
# Format is Java .properties: KEY=value, no quotes. Use forward slashes in paths, even on Windows.

# Port the backend API listens on
SERVER_PORT=8080

# SQLite database file (relative to the backend folder, or an absolute path)
DB_PATH=data/shop.db

# Comma-separated browser origins allowed to call the API (where the frontend is served from)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500